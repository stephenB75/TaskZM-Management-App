# Google Calendar OAuth — Supabase Edge Function secrets
# Copy to supabase/google-oauth.env, fill in values from Google Cloud Console, then run:
#   npm run setup:google-calendar
#
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web application)
# Authorized redirect URI must include GOOGLE_REDIRECT_URI below exactly.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=https://gflesnyfpxqhaunfskrw.supabase.co/functions/v1/taskzm-database-function/calendar/google/callback
APP_URL=https://taskzm.com
