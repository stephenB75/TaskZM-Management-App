# Environment Variables for TaskZM
# Copy this file to .env and fill in your actual values

# ============================================
# FRONTEND VARIABLES (Vite)
# ============================================
# These go in the .env file in the project root

# Supabase project (optional override; used by calendar/API base URLs)
# If unset, app uses the built-in project ref. Set when building for a different project (e.g. staging).
# VITE_SUPABASE_PROJECT_REF=your-project-ref
# VITE_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat Web Public Key (Required for payment processing)
# Used in the browser and as web-checkout fallback in native iOS/Android builds
# Get this from: RevenueCat Dashboard → Project Settings → API Keys → Web Public Key
VITE_REVENUECAT_WEB_PUBLIC_KEY=rcb_OXJjKGSEpjpdaauCINwqRtgBeeKN

# RevenueCat Native Public Keys (Required for App Store / Play Store IAP in native apps)
# When both native and web keys are set, users can choose either payment method in the app
# iOS: RevenueCat Dashboard → Apps → iOS → API Keys → Public API Key
# Android: RevenueCat Dashboard → Apps → Android → API Keys → Public API Key
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=

# Optional: Supabase Auth redirect URLs for native (add to Supabase Dashboard → Auth → URL Configuration)
# com.app.taskzm.com://reset-password
# com.app.taskzm.com://auth-callback

# Stripe Publishable Key (Optional - only if using Stripe directly)
# Get this from: Stripe Dashboard → Developers → API keys → Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51S3TBVGU17VPIUzBL1TOrtnZpOkGAeE5lGZUZGsBsn3cFXPTBbHWXftibpOm5ExL674lB1ar8WU3GlDRwII8Ac6Q00HMMbsNmp

# ============================================
# BACKEND VARIABLES (Supabase Edge Functions)
# ============================================
# These go in Supabase Dashboard → Project Settings → Edge Functions → Secrets
# DO NOT put these in the .env file!

# REVENUECAT_WEBHOOK_SECRET
# Get from: RevenueCat Dashboard → Settings → Webhooks → Authorization Token

# STRIPE_SECRET_KEY
# Get from: Stripe Dashboard → Developers → API keys → Secret key

# APP_URL
# Your app's public URL (e.g., https://your-domain.com)

# MOBILE_DEEP_LINK_SCHEME (optional)
# Custom URL scheme for native OAuth redirects (default: com.app.taskzm.com)
# MOBILE_DEEP_LINK_SCHEME=com.app.taskzm.com

# OPENAI_API_KEY (optional)
# Enables server-side AI for task description generation (POST /ai/description and /ai/description-options).
# If not set, the app falls back to local-only description building and you will see no usage on the OpenAI portal.
# Usage appears at https://platform.openai.com/usage only when this key is set and the Edge Function successfully
# calls the OpenAI API (user must be signed in; 401/503/timeouts cause fallback to local, so no API usage).
# Get from: https://platform.openai.com/api-keys
#
# OPENAI_CHAT_URL (optional) — Edge Function only. Default: https://api.openai.com/v1/chat/completions
# OPENAI_MODEL (optional) — Edge Function only. Default: gpt-4o-mini

# Outlook Calendar OAuth (optional — required for Outlook calendar connect)
# Get from: Azure Portal → App registrations → Your app → Overview (Application ID) and Certificates & secrets
# OUTLOOK_CLIENT_ID=your-azure-application-client-id
# OUTLOOK_CLIENT_SECRET=your-azure-client-secret
# OUTLOOK_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/taskzm-database-function/calendar/outlook/callback

# Google Calendar OAuth (optional — required for Google calendar connect)
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/taskzm-database-function/calendar/google/callback
