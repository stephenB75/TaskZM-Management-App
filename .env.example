# Environment Variables for TaskZM
# Copy this file to .env and fill in your actual values

# ============================================
# FRONTEND VARIABLES (Vite)
# ============================================
# These go in the .env file in the project root

# RevenueCat Web Public Key (Required for payment processing)
# Get this from: RevenueCat Dashboard → Project Settings → API Keys → Web Public Key
VITE_REVENUECAT_WEB_PUBLIC_KEY=rcb_OXJjKGSEpjpdaauCINwqRtgBeeKN

# Stripe Publishable Key (Optional - only if using Stripe directly)
# Get this from: Stripe Dashboard → Developers → API keys → Publishable key
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51S3TBVGU17VPIUzBL1TOrtnZpOkGAeE5lGZUZGsBsn3cFXPTBbHWXftibpOm5ExL674lB1ar8WU3GlDRwII8Ac6Q00HMMbsNmp

# ============================================
# BACKEND VARIABLES (Supabase Edge Functions)
# ============================================
# These go in Supabase Dashboard → Project Settings → Edge Functions → Secrets
# DO NOT put these in the .env file!

# REVENUECAT_WEBHOOK_SECRET
# Get from: RevenueCat Dashboard → Settings → Webhooks → Authorization Token

# STRIPE_SECRET_KEY
# Get from: Stripe Dashboard → Developers → API keys → Secret key

# APP_URL
# Your app's public URL (e.g., https://your-domain.com)

# OPENAI_API_KEY (optional)
# Enables server-side AI for task description generation (POST /ai/description and /ai/description-options).
# If not set, the app falls back to local-only description building and you will see no usage on the OpenAI portal.
# Usage appears at https://platform.openai.com/usage only when this key is set and the Edge Function successfully
# calls the OpenAI API (user must be signed in; 401/503/timeouts cause fallback to local, so no API usage).
# Get from: https://platform.openai.com/api-keys
#
# OPENAI_CHAT_URL (optional) — Edge Function only. Default: https://api.openai.com/v1/chat/completions
# OPENAI_MODEL (optional) — Edge Function only. Default: gpt-4o-mini
