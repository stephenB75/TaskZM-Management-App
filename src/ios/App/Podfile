require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorBrowser', :path => '../../node_modules/@capacitor/browser'
  pod 'CapacitorHaptics', :path => '../../node_modules/@capacitor/haptics'
  pod 'CapacitorKeyboard', :path => '../../node_modules/@capacitor/keyboard'
  pod 'CapacitorLocalNotifications', :path => '../../node_modules/@capacitor/local-notifications'
  pod 'CapacitorSplashScreen', :path => '../../node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar', :path => '../../node_modules/@capacitor/status-bar'
  pod 'RevenuecatPurchasesCapacitor', :path => '../../node_modules/@revenuecat/purchases-capacitor'
end

target 'App' do
  capacitor_pods
end

def disable_module_verifier!(config)
  config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
  config.build_settings['CLANG_ENABLE_MODULE_VERIFIER'] = 'NO'
  config.build_settings.delete('MODULE_VERIFIER_SUPPORTED_LANGUAGES')
  config.build_settings.delete('MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS')
end

def configure_pod_target_settings(config, suppress_third_party_warnings: false)
  config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
  config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
  disable_module_verifier!(config)
  return unless suppress_third_party_warnings

  # Capacitor/Cordova/RevenueCat ship SDK deprecations we cannot patch in node_modules.
  config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
  config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
  config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
  config.build_settings['CLANG_WARN_DEPRECATED_OBJC_IMPLEMENTATIONS'] = 'NO'
  config.build_settings['GCC_WARN_ABOUT_DEPRECATED_FUNCTIONS'] = 'NO'
  other_cflags = config.build_settings['OTHER_CFLAGS'] || '$(inherited)'
  other_cflags = [other_cflags] unless other_cflags.is_a?(Array)
  %w[-Wno-deprecated-declarations -Wno-quoted-include-in-framework-header].each do |flag|
    next if other_cflags.any? { |existing| existing.include?(flag.sub('-Wno-', '-W')) }

    other_cflags << flag
  end
  config.build_settings['OTHER_CFLAGS'] = other_cflags
end

def fix_cocoapods_script_phases(project)
  project.native_targets.each do |target|
    target.shell_script_build_phases.each do |phase|
      next unless phase.name&.start_with?('[CP]')

      # Allow Xcode dependency analysis instead of running every build.
      phase.always_out_of_date = '0'
    end
  end
end

def patch_capacitor_cordova_framework_headers
  marker = 'TASKZM_CORDOVA_ANGLE_INCLUDES'
  public_dir = File.expand_path(
    '../../node_modules/@capacitor/ios/CapacitorCordova/CapacitorCordova/Classes/Public',
    __dir__,
  )
  return unless Dir.exist?(public_dir)

  public_headers = Dir.glob(File.join(public_dir, '*.h')).map { |path| File.basename(path) }

  Dir.glob(File.join(public_dir, '*.h')).each do |path|
    content = File.read(path)
    next if content.include?(marker)

    patched = content.gsub(/#import\s+"([^"]+\.h)"/) do
      header = Regexp.last_match(1)
      if public_headers.include?(header)
        "#import <Cordova/#{header}> /* #{marker} */"
      else
        Regexp.last_match(0)
      end
    end

    File.write(path, patched) if patched != content
  end
end

def patch_capacitor_framework_headers
  marker = 'TASKZM_CAPACITOR_ANGLE_INCLUDES'
  cordova_impl_marker = 'TASKZM_CAPACITOR_CORDOVA_IMPL'
  orientation_marker = 'TASKZM_CDV_SCREEN_ORIENTATION_IMPORT'
  capacitor_dir = File.expand_path(
    '../../node_modules/@capacitor/ios/Capacitor/Capacitor',
    __dir__,
  )
  return unless Dir.exist?(capacitor_dir)

  public_headers = Dir.glob(File.join(capacitor_dir, '*.h')).map { |path| File.basename(path) }

  Dir.glob(File.join(capacitor_dir, '*.h')).each do |path|
    content = File.read(path)
    patched = content

    unless content.include?(marker)
      patched = patched.gsub(/#import\s+"([^"]+\.h)"/) do
        header = Regexp.last_match(1)
        if public_headers.include?(header)
          "#import <Capacitor/#{header}> /* #{marker} */"
        else
          Regexp.last_match(0)
        end
      end
    end

    basename = File.basename(path)
    if basename == 'CAPInstanceDescriptor.h'
      patched = patched
        .gsub("#import <UIKit/UIKit.h> /* #{marker} */", "@import UIKit; /* #{marker} */")
        .gsub("#import <Cordova/CDVConfigParser.h> /* #{marker} */", "@class CDVConfigParser; /* #{marker} */")
        .gsub('@import Cordova;', "@class CDVConfigParser; /* #{marker} */")
      unless patched.include?('@class CDVConfigParser')
        patched = patched.sub(/@import UIKit;\s*\n/, "@import UIKit;\n@class CDVConfigParser; /* #{marker} */\n")
      end
    end

    if basename == 'CAPBridgeViewController+CDVScreenOrientationDelegate.h'
      patched = patched
        .gsub(
          "@protocol CDVScreenOrientationDelegate; /* #{orientation_marker} */",
          "#import <Cordova/CDVScreenOrientationDelegate.h> /* #{orientation_marker} */",
        )
      unless patched.include?('CDVScreenOrientationDelegate.h')
        patched = patched.sub(
          "#import <Capacitor/Capacitor-Swift.h>\n",
          "#import <Capacitor/Capacitor-Swift.h>\n" \
          "#import <Cordova/CDVScreenOrientationDelegate.h> /* #{orientation_marker} */\n",
        )
      end
    end

    File.write(path, patched) if patched != content
  end

  orientation_impl_marker = 'TASKZM_CDV_SCREEN_ORIENTATION_IMPL'
  orientation_impl = File.join(capacitor_dir, 'CAPBridgeViewController+CDVScreenOrientationDelegate.m')
  if File.exist?(orientation_impl)
    impl = File.read(orientation_impl)
    unless impl.include?(orientation_impl_marker)
      patched_impl = impl.sub(
        "#import \"CAPBridgeViewController+CDVScreenOrientationDelegate.h\"\n",
        "#import \"CAPBridgeViewController+CDVScreenOrientationDelegate.h\"\n" \
        "#import <Cordova/CDVScreenOrientationDelegate.h> /* #{orientation_impl_marker} */\n",
      )
      File.write(orientation_impl, patched_impl) if patched_impl != impl
    end
  end

  descriptor_impl = File.join(capacitor_dir, 'CAPInstanceDescriptor.m')
  if File.exist?(descriptor_impl)
    impl = File.read(descriptor_impl)
    unless impl.include?(cordova_impl_marker)
      patched_impl = impl.sub(
        "#import \"CAPInstanceDescriptor.h\"\n",
        "#import \"CAPInstanceDescriptor.h\"\n#import <Cordova/CDVConfigParser.h> /* #{cordova_impl_marker} */\n",
      )
      File.write(descriptor_impl, patched_impl) if patched_impl != impl
    end
  end
end

def silence_capacitor_cordova_wkprocesspool_deprecations
  patch_script = File.expand_path('../../../scripts/patch-capacitor-wkprocesspool.cjs', __dir__)
  if File.exist?(patch_script)
    system('node', patch_script, File.expand_path('../..', __dir__)) || warn('WKProcessPool patch script failed')
    return
  end

  marker = 'TASKZM_SUPPRESS_WKPROCESSPOOL_DEPRECATION'
  base = File.expand_path(
    '../../node_modules/@capacitor/ios/CapacitorCordova/CapacitorCordova/Classes/Public',
    __dir__,
  )

  header = File.join(base, 'CDVWebViewProcessPoolFactory.h')
  impl = File.join(base, 'CDVWebViewProcessPoolFactory.m')

  if File.exist?(header) && !File.read(header).include?(marker)
    File.write(
      header,
      File.read(header).sub(
        "#import <WebKit/WebKit.h>\n\n@interface",
        "#import <WebKit/WebKit.h>\n\n#pragma clang diagnostic push\n" \
        "#pragma clang diagnostic ignored \"-Wdeprecated-declarations\"\n" \
        "/* #{marker} */\n\n@interface",
      ).sub(
        "@end\n",
        "@end\n\n#pragma clang diagnostic pop\n",
      ),
    )
  end

  if File.exist?(impl) && !File.read(impl).include?(marker)
    File.write(
      impl,
      File.read(impl).sub(
        /(#import <Cordova\/CDVWebViewProcessPoolFactory\.h>\n\n)/,
        "#import <Cordova/CDVWebViewProcessPoolFactory.h>\n\n" \
        "#pragma clang diagnostic push\n" \
        "#pragma clang diagnostic ignored \"-Wdeprecated-declarations\"\n" \
        "/* #{marker} */\n\n",
      ).sub(
        "@end\n",
        "@end\n\n#pragma clang diagnostic pop\n",
      ),
    )
  end
end

post_install do |installer|
  assertDeploymentTarget(installer)
  patch_capacitor_cordova_framework_headers
  patch_capacitor_framework_headers
  silence_capacitor_cordova_wkprocesspool_deprecations

  installer.pods_project.build_configurations.each do |config|
    disable_module_verifier!(config)
  end

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      configure_pod_target_settings(config, suppress_third_party_warnings: true)
    end
  end

  installer.aggregate_targets.each do |aggregate_target|
    fix_cocoapods_script_phases(aggregate_target.user_project)
    aggregate_target.user_project.native_targets.each do |target|
      target.build_configurations.each do |config|
        configure_pod_target_settings(
          config,
          suppress_third_party_warnings: target.name != 'App',
        )
      end
    end
    aggregate_target.user_project.save
  end
end
